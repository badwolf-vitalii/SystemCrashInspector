<ui:FluentWindow x:Class="SystemCrashInspector.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="System Crash Inspector" Width="1480" Height="930"
        MinWidth="1050" MinHeight="690"
        ExtendsContentIntoTitleBar="True"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource CanvasBrush}"
        Foreground="{StaticResource TextPrimaryBrush}"
        FontFamily="Segoe UI">
    <Grid Background="{StaticResource CanvasBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="44"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="System Crash Inspector" Background="{StaticResource SidebarBrush}"/>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="220"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Side navigation and brand -->
            <Border Grid.Column="0" Background="{StaticResource SidebarBrush}"
                    BorderBrush="{StaticResource OutlineBrush}" BorderThickness="0,0,1,0">
                <DockPanel Margin="14,20,14,16" LastChildFill="False">
                    <StackPanel DockPanel.Dock="Top">
                        <StackPanel Orientation="Horizontal" Margin="8,3,0,30">
                            <Border Width="42" Height="42" CornerRadius="12" Background="{StaticResource AccentDimBrush}"
                                    BorderBrush="#3872A5" BorderThickness="1" Margin="0,0,11,0">
                                <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE9CE;"
                                           Foreground="{StaticResource AccentBrush}" FontSize="23"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="SYSTEM CRASH" FontSize="12" FontWeight="Bold"
                                           Style="{StaticResource PrimaryTextStyle}"/>
                                <TextBlock Text="INSPECTOR" FontSize="12" FontWeight="Bold"
                                           Foreground="{StaticResource AccentBrush}"/>
                            </StackPanel>
                        </StackPanel>

                        <TextBlock Text="WORKSPACE" Style="{StaticResource MicroLabelStyle}" Margin="14,0,0,9"/>
                        <RadioButton x:Name="IncidentsNav" GroupName="Pages" IsChecked="True"
                                     Style="{StaticResource SidebarLinkStyle}" Checked="Navigation_Checked">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE814;" FontFamily="Segoe MDL2 Assets"
                                           FontSize="17" Width="27" VerticalAlignment="Center"/>
                                <TextBlock Text="Incidents" VerticalAlignment="Center"/>
                            </StackPanel>
                        </RadioButton>
                        <RadioButton x:Name="EventsNav" GroupName="Pages"
                                     Style="{StaticResource SidebarLinkStyle}" Checked="Navigation_Checked">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE9D9;" FontFamily="Segoe MDL2 Assets"
                                           FontSize="17" Width="27" VerticalAlignment="Center"/>
                                <TextBlock Text="Event log" VerticalAlignment="Center"/>
                            </StackPanel>
                        </RadioButton>
                        <Separator Background="{StaticResource OutlineBrush}" Margin="6,22,6,22"/>
                        <TextBlock Text="DIAGNOSTICS" Style="{StaticResource MicroLabelStyle}" Margin="14,0,0,13"/>
                        <Border Style="{StaticResource SectionCardStyle}" Padding="12" Background="#14263B">
                            <StackPanel>
                                <TextBlock Text="&#xE814;  Evidence-based" FontSize="12"
                                           Foreground="{StaticResource AccentBrush}" FontWeight="SemiBold"/>
                                <TextBlock Text="Event logs and dump metadata are collected locally."
                                           Style="{StaticResource MutedTextStyle}" TextWrapping="Wrap"
                                           FontSize="11" Margin="0,9,0,0"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <StackPanel DockPanel.Dock="Bottom" Margin="8,10,4,0">
                        <TextBlock Text="LOCAL ANALYSIS" Style="{StaticResource MicroLabelStyle}"/>
                        <TextBlock Text="No data is uploaded." Style="{StaticResource MutedTextStyle}"
                                   FontSize="11" Margin="0,5,0,0"/>
                        <TextBlock Text=".NET 8  •  Windows" Foreground="{StaticResource TextSubtleBrush}"
                                   FontSize="11" Margin="0,8,0,0"/>
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- Dashboard -->
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0" BorderBrush="{StaticResource OutlineBrush}"
                        BorderThickness="0,0,0,1" Padding="28,19,26,19">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Diagnostics dashboard" FontSize="25" FontWeight="SemiBold"
                                       Style="{StaticResource PrimaryTextStyle}"/>
                            <TextBlock Text="Investigate system restarts, application failures, and supporting evidence."
                                       Style="{StaticResource MutedTextStyle}" FontSize="12" Margin="0,5,0,0"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="PERIOD" Style="{StaticResource MicroLabelStyle}"
                                       VerticalAlignment="Center" Margin="0,0,10,0"/>
                            <ComboBox x:Name="PeriodPicker" Width="156" Height="38"
                                      SelectedIndex="0" Margin="0,0,10,0">
                                <ComboBoxItem Content="Last 1 hour" Tag="1"/>
                                <ComboBoxItem Content="Last 12 hours" Tag="12"/>
                                <ComboBoxItem Content="Last 24 hours" Tag="24"/>
                                <ComboBoxItem Content="Last 7 days" Tag="168"/>
                                <ComboBoxItem Content="Last 30 days" Tag="720"/>
                                <ComboBoxItem Content="Last 90 days" Tag="2160"/>
                            </ComboBox>
                            <Button x:Name="RefreshButton" Style="{StaticResource AccentButtonStyle}"
                                    Click="Refresh_Click" Margin="0,0,8,0" ToolTip="Reload the event logs">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE72C;" FontFamily="Segoe MDL2 Assets"
                                               FontSize="14" Margin="0,0,8,0"/>
                                    <TextBlock Text="Scan"/>
                                </StackPanel>
                            </Button>
                            <Button x:Name="ExportButton" Style="{StaticResource DashboardButtonStyle}"
                                    Click="Export_Click" ToolTip="Export the loaded events to CSV">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE74E;" FontFamily="Segoe MDL2 Assets"
                                               FontSize="14" Margin="0,0,7,0"/>
                                    <TextBlock Text="Export CSV"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Landing page: overview, incident list, incident details -->
                <Grid x:Name="IncidentsPage" Grid.Row="1" Margin="26,20,26,20">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="94"/>
                        <RowDefinition Height="16"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="13"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="13"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Style="{StaticResource SectionCardStyle}" Padding="17,13">
                            <DockPanel>
                                <Border DockPanel.Dock="Right" Width="42" Height="42" CornerRadius="11"
                                        Background="{StaticResource AccentDimBrush}" VerticalAlignment="Center">
                                    <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE9D9;" FontSize="19"
                                               Foreground="{StaticResource AccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel>
                                    <TextBlock Text="DETECTED INCIDENTS" Style="{StaticResource MicroLabelStyle}"/>
                                    <TextBlock x:Name="IncidentsCountText" Text="—" FontSize="27" FontWeight="SemiBold"
                                               Style="{StaticResource PrimaryTextStyle}" Margin="0,5,0,0"/>
                                </StackPanel>
                            </DockPanel>
                        </Border>
                        <Border Grid.Column="2" Style="{StaticResource SectionCardStyle}" Padding="17,13">
                            <DockPanel>
                                <Border DockPanel.Dock="Right" Width="42" Height="42" CornerRadius="11"
                                        Background="{StaticResource WarningDimBrush}" VerticalAlignment="Center">
                                    <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE7BA;" FontSize="19"
                                               Foreground="{StaticResource WarningBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel>
                                    <TextBlock Text="SYSTEM RESTARTS" Style="{StaticResource MicroLabelStyle}"/>
                                    <TextBlock x:Name="RestartsCountText" Text="—" FontSize="27" FontWeight="SemiBold"
                                               Style="{StaticResource PrimaryTextStyle}" Margin="0,5,0,0"/>
                                </StackPanel>
                            </DockPanel>
                        </Border>
                        <Border Grid.Column="4" Style="{StaticResource SectionCardStyle}" Padding="17,13">
                            <DockPanel>
                                <Border DockPanel.Dock="Right" Width="42" Height="42" CornerRadius="11"
                                        Background="{StaticResource SuccessDimBrush}" VerticalAlignment="Center">
                                    <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE9D9;" FontSize="19"
                                               Foreground="{StaticResource SuccessBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel>
                                    <TextBlock Text="EVENTS ANALYZED" Style="{StaticResource MicroLabelStyle}"/>
                                    <TextBlock x:Name="EventsCountText" Text="—" FontSize="27" FontWeight="SemiBold"
                                               Style="{StaticResource PrimaryTextStyle}" Margin="0,5,0,0"/>
                                </StackPanel>
                            </DockPanel>
                        </Border>
                    </Grid>

                    <Grid Grid.Row="2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="345" MinWidth="270"/>
                            <ColumnDefinition Width="16"/>
                            <ColumnDefinition Width="*" MinWidth="450"/>
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Style="{StaticResource SectionCardStyle}" Padding="15">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <DockPanel Margin="3,1,3,15">
                                    <TextBlock Text="Recent incidents" FontSize="16" FontWeight="SemiBold"
                                               Style="{StaticResource PrimaryTextStyle}"/>
                                    <TextBlock x:Name="IncidentListCountText" DockPanel.Dock="Right"
                                               HorizontalAlignment="Right" Text="0" FontSize="12"
                                               Foreground="{StaticResource AccentBrush}" VerticalAlignment="Center"/>
                                </DockPanel>
                                <Grid Grid.Row="1">
                                    <ListBox x:Name="IncidentsList" Style="{StaticResource IncidentListStyle}"
                                             ItemContainerStyle="{StaticResource IncidentListItemStyle}"
                                             SelectionChanged="IncidentsList_SelectionChanged">
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <StackPanel>
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto"/>
                                                            <ColumnDefinition Width="*"/>
                                                        </Grid.ColumnDefinitions>
                                                        <Border Width="34" Height="34" CornerRadius="9" Background="{StaticResource WarningDimBrush}"
                                                                Margin="0,0,10,0">
                                                            <TextBlock Text="{Binding Icon}" Foreground="{StaticResource WarningBrush}"
                                                                       FontSize="17" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                        </Border>
                                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding DisplayTitle}" FontWeight="SemiBold"
                                                                       FontSize="12" TextTrimming="CharacterEllipsis"
                                                                       Style="{StaticResource PrimaryTextStyle}"/>
                                                            <TextBlock Text="{Binding Time, StringFormat={}{0:yyyy-MM-dd HH:mm:ss}}"
                                                                       FontSize="11" Style="{StaticResource MutedTextStyle}" Margin="0,3,0,0"/>
                                                        </StackPanel>
                                                    </Grid>
                                                    <TextBlock Text="{Binding Summary}" FontSize="11"
                                                               Style="{StaticResource MutedTextStyle}"
                                                               TextTrimming="CharacterEllipsis" Margin="0,10,0,7"/>
                                                    <TextBlock Text="{Binding StatusLabel}" FontSize="10" FontWeight="Bold"
                                                               Foreground="{StaticResource AccentBrush}"/>
                                                </StackPanel>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                    <TextBlock x:Name="NoIncidentsText" Text="No incidents found in this time range.&#x0A;Try a longer period and scan again."
                                               Style="{StaticResource MutedTextStyle}" FontSize="12"
                                               TextAlignment="Center" TextWrapping="Wrap"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"
                                               Visibility="Collapsed" Padding="20"/>
                                </Grid>
                            </Grid>
                        </Border>

                        <Border Grid.Column="2" Style="{StaticResource SectionCardStyle}" Padding="0">
                            <Grid>
                                <Grid x:Name="EmptyIncidentRoot">
                                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <TextBlock Text="&#xE9CE;" FontFamily="Segoe MDL2 Assets"
                                                   FontSize="46" Foreground="{StaticResource AccentBrush}"
                                                   HorizontalAlignment="Center"/>
                                        <TextBlock Text="Select an incident" FontSize="20" FontWeight="SemiBold"
                                                   Style="{StaticResource PrimaryTextStyle}" Margin="0,20,0,7"
                                                   HorizontalAlignment="Center"/>
                                        <TextBlock Text="Choose an item on the left to inspect the evidence, timeline, and matching dump files."
                                                   Style="{StaticResource MutedTextStyle}" TextWrapping="Wrap"
                                                   TextAlignment="Center" MaxWidth="350"/>
                                    </StackPanel>
                                </Grid>
                                <Grid x:Name="IncidentDetailsRoot" Visibility="Collapsed" Margin="20,18,20,12">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="14"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="16"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>
                                    <Grid Grid.Row="0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="INCIDENT ANALYSIS" Style="{StaticResource MicroLabelStyle}"
                                                       Foreground="{StaticResource AccentBrush}"/>
                                            <TextBlock Text="{Binding DisplayTitle}" FontSize="22" FontWeight="SemiBold"
                                                       Style="{StaticResource PrimaryTextStyle}" Margin="0,7,0,2"
                                                       TextWrapping="Wrap"/>
                                            <TextBlock Text="{Binding Time, StringFormat={}{0:yyyy-MM-dd HH:mm:ss}}"
                                                       Style="{StaticResource MutedTextStyle}" FontSize="12"/>
                                        </StackPanel>
                                        <Button Grid.Column="1" Style="{StaticResource DashboardButtonStyle}"
                                                Click="CopyReport_Click" Margin="8,5,0,0" VerticalAlignment="Top"
                                                ToolTip="Copy the complete incident report">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE8C8;" Margin="0,0,8,0"/>
                                                <TextBlock Text="Copy report"/>
                                            </StackPanel>
                                        </Button>
                                    </Grid>

                                    <Grid Grid.Row="2">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="10"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="10"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Grid.Column="0" Background="#192B40" CornerRadius="10" Padding="13,11">
                                            <StackPanel>
                                                <TextBlock Text="BUGCHECK" Style="{StaticResource MicroLabelStyle}"/>
                                                <TextBlock Text="{Binding BugCheckLabel}" FontSize="19" FontWeight="Bold"
                                                           Style="{StaticResource PrimaryTextStyle}" Margin="0,4,0,0"/>
                                            </StackPanel>
                                        </Border>
                                        <Border Grid.Column="2" Background="#192B40" CornerRadius="10" Padding="13,11">
                                            <StackPanel>
                                                <TextBlock Text="EVIDENCE" Style="{StaticResource MicroLabelStyle}"/>
                                                <TextBlock Text="{Binding EvidenceCount}" FontSize="19" FontWeight="Bold"
                                                           Style="{StaticResource PrimaryTextStyle}" Margin="0,4,0,0"/>
                                            </StackPanel>
                                        </Border>
                                        <Border Grid.Column="4" Background="#192B40" CornerRadius="10" Padding="13,11">
                                            <StackPanel>
                                                <TextBlock Text="DUMP FILES" Style="{StaticResource MicroLabelStyle}"/>
                                                <TextBlock Text="{Binding DumpCount}" FontSize="19" FontWeight="Bold"
                                                           Style="{StaticResource PrimaryTextStyle}" Margin="0,4,0,0"/>
                                            </StackPanel>
                                        </Border>
                                    </Grid>

                                    <TabControl x:Name="IncidentTabs" Grid.Row="4" Background="Transparent"
                                                BorderThickness="0" Padding="0"
                                                ItemContainerStyle="{StaticResource DashboardTabItemStyle}">
                                        <TabItem Header="Overview">
                                            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                                <StackPanel Margin="0,15,7,12">
                                                    <Border Background="#182D44" BorderBrush="#355776"
                                                            BorderThickness="1" CornerRadius="10" Padding="16">
                                                        <StackPanel>
                                                            <TextBlock Text="{Binding StatusLabel}" Foreground="{StaticResource WarningBrush}"
                                                                       FontSize="11" FontWeight="Bold"/>
                                                            <TextBlock Text="{Binding Explanation}" Style="{StaticResource PrimaryTextStyle}"
                                                                       FontSize="14" TextWrapping="Wrap" Margin="0,11,0,0"/>
                                                            <TextBlock Text="{Binding Summary}" Style="{StaticResource MutedTextStyle}"
                                                                       FontSize="12" TextWrapping="Wrap" Margin="0,9,0,0"/>
                                                        </StackPanel>
                                                    </Border>
                                                    <TextBlock Text="NEXT STEP" Style="{StaticResource MicroLabelStyle}" Margin="3,23,0,9"/>
                                                    <TextBlock Text="{Binding NextStep}" Style="{StaticResource PrimaryTextStyle}"
                                                               TextWrapping="Wrap" FontSize="13" Margin="3,0,8,0"/>
                                                    <Border Background="#201F2A" BorderBrush="#4D3F42" BorderThickness="1"
                                                            CornerRadius="10" Padding="13" Margin="0,23,0,0">
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock Text="&#xE7BA;" FontFamily="Segoe MDL2 Assets"
                                                                       Foreground="{StaticResource WarningBrush}" FontSize="17"
                                                                       Margin="0,0,10,0"/>
                                                            <TextBlock Text="This report links evidence; it does not identify a confirmed root cause or analyze dump contents."
                                                                       Foreground="{StaticResource TextSecondaryBrush}"
                                                                       TextWrapping="Wrap" FontSize="12" MaxWidth="680"/>
                                                        </StackPanel>
                                                    </Border>
                                                </StackPanel>
                                            </ScrollViewer>
                                        </TabItem>

                                        <TabItem Header="Event timeline">
                                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                                <ItemsControl ItemsSource="{Binding Evidence}" Margin="0,15,7,12">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Grid Margin="4,0,4,13">
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="90"/>
                                                                    <ColumnDefinition Width="20"/>
                                                                    <ColumnDefinition Width="*"/>
                                                                </Grid.ColumnDefinitions>
                                                                <TextBlock Text="{Binding Time, StringFormat={}{0:HH:mm:ss}}"
                                                                           Style="{StaticResource MutedTextStyle}"
                                                                           FontSize="12" VerticalAlignment="Top" Margin="0,13,0,0"/>
                                                                <TextBlock Grid.Column="1" Text="●" FontSize="14"
                                                                           Foreground="{StaticResource AccentBrush}" Margin="0,10,0,0"/>
                                                                <Border Grid.Column="2" Background="#17263C" CornerRadius="9" Padding="12">
                                                                    <StackPanel>
                                                                        <TextBlock Text="{Binding Title}" Style="{StaticResource PrimaryTextStyle}"
                                                                                   FontWeight="SemiBold" FontSize="12" TextWrapping="Wrap"/>
                                                                        <TextBlock Text="{Binding Message}" Style="{StaticResource MutedTextStyle}"
                                                                                   FontSize="11" TextWrapping="Wrap" Margin="0,5,0,0"/>
                                                                    </StackPanel>
                                                                </Border>
                                                            </Grid>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </ScrollViewer>
                                        </TabItem>

                                        <TabItem Header="Minidumps">
                                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                                <StackPanel Margin="0,15,6,12">
                                                    <TextBlock Text="Nearby system dump files (metadata only)"
                                                               Style="{StaticResource MutedTextStyle}" FontSize="12" Margin="0,0,0,12"/>
                                                    <ItemsControl ItemsSource="{Binding Dumps}">
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate>
                                                                <Border Background="#17263C" CornerRadius="10" Padding="13"
                                                                        Margin="0,0,0,12" BorderBrush="{StaticResource OutlineBrush}"
                                                                        BorderThickness="1">
                                                                    <Grid>
                                                                        <Grid.ColumnDefinitions>
                                                                            <ColumnDefinition Width="*"/>
                                                                            <ColumnDefinition Width="Auto"/>
                                                                        </Grid.ColumnDefinitions>
                                                                        <StackPanel>
                                                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold"
                                                                                       Style="{StaticResource PrimaryTextStyle}" FontSize="13"/>
                                                                            <TextBlock Text="{Binding Info}" Style="{StaticResource MutedTextStyle}"
                                                                                       FontSize="11" Margin="0,5,0,0"/>
                                                                            <TextBlock Text="{Binding Path}" Style="{StaticResource MutedTextStyle}"
                                                                                       FontSize="11" TextWrapping="Wrap" Margin="0,5,0,0"/>
                                                                        </StackPanel>
                                                                        <Button Grid.Column="1" Style="{StaticResource DashboardButtonStyle}"
                                                                                Content="Show file" Click="OpenDump_Click"
                                                                                CommandParameter="{Binding Path}" Margin="12,0,0,0"
                                                                                VerticalAlignment="Center"/>
                                                                    </Grid>
                                                                </Border>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                    <TextBlock Text="If no files appear, Windows did not expose a matching dump in the checked locations."
                                                               Style="{StaticResource MutedTextStyle}" TextWrapping="Wrap" FontSize="11"/>
                                                </StackPanel>
                                            </ScrollViewer>
                                        </TabItem>

                                        <TabItem Header="Raw report">
                                            <TextBox Style="{StaticResource RawOutputStyle}"
                                                     Text="{Binding Details, Mode=OneWay}" Margin="0,13,0,3"/>
                                        </TabItem>
                                    </TabControl>
                                </Grid>
                            </Grid>
                        </Border>
                    </Grid>
                </Grid>

                <!-- Separate, searchable raw-event view remains available. -->
                <Grid x:Name="EventsPage" Grid.Row="1" Margin="26,20,26,20" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="14"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="13"/>
                        <RowDefinition Height="210"/>
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="320"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Windows event log" FontSize="19" FontWeight="SemiBold"
                                       Style="{StaticResource PrimaryTextStyle}"/>
                            <TextBlock Text="Selected System and Application events with their original descriptions and XML."
                                       Style="{StaticResource MutedTextStyle}" FontSize="12" Margin="0,4,0,0"/>
                        </StackPanel>
                        <TextBox Grid.Column="1" x:Name="EventSearchBox" VerticalAlignment="Center" Height="36"
                                 TextChanged="EventSearchBox_TextChanged"
                                 ToolTip="Search by provider, message, ID, or category"/>
                    </Grid>
                    <Border Grid.Row="2" Style="{StaticResource SectionCardStyle}" Padding="1">
                        <DataGrid x:Name="EventsGrid" Style="{StaticResource DiagnosticDataGridStyle}"
                                  ColumnHeaderStyle="{StaticResource DiagnosticHeaderStyle}"
                                  CellStyle="{StaticResource DiagnosticCellStyle}"
                                  RowStyle="{StaticResource DiagnosticRowStyle}"
                                  SelectionChanged="EventsGrid_SelectionChanged">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="DATE / TIME" Binding="{Binding TimeCreated, StringFormat={}{0:yyyy-MM-dd HH:mm:ss}}"
                                                    ElementStyle="{StaticResource DiagnosticGridTextStyle}" Width="165"/>
                                <DataGridTextColumn Header="LOG" Binding="{Binding LogName}"
                                                    ElementStyle="{StaticResource DiagnosticGridTextStyle}" Width="105"/>
                                <DataGridTextColumn Header="ID" Binding="{Binding EventId}"
                                                    ElementStyle="{StaticResource DiagnosticGridTextStyle}" Width="64"/>
                                <DataGridTextColumn Header="CATEGORY" Binding="{Binding Category}"
                                                    ElementStyle="{StaticResource DiagnosticGridTextStyle}" Width="185"/>
                                <DataGridTextColumn Header="SOURCE" Binding="{Binding Source}"
                                                    ElementStyle="{StaticResource DiagnosticGridTextStyle}" Width="180"/>
                                <DataGridTextColumn Header="LEVEL" Binding="{Binding Level}"
                                                    ElementStyle="{StaticResource DiagnosticGridTextStyle}" Width="100"/>
                                <DataGridTextColumn Header="MESSAGE" Binding="{Binding Message}"
                                                    ElementStyle="{StaticResource DiagnosticGridTextStyle}" Width="*"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Border>
                    <Border Grid.Row="4" Style="{StaticResource SectionCardStyle}" Padding="0">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <Border Padding="14,11" BorderThickness="0,0,0,1"
                                    BorderBrush="{StaticResource OutlineBrush}">
                                <TextBlock Text="Event details / raw XML" FontSize="13" FontWeight="SemiBold"
                                           Style="{StaticResource PrimaryTextStyle}"/>
                            </Border>
                            <TextBox x:Name="EventDetailsText" Grid.Row="1"
                                     Style="{StaticResource RawOutputStyle}" />
                        </Grid>
                    </Border>
                </Grid>

                <Border Grid.Row="2" Background="{StaticResource SidebarBrush}" BorderThickness="0,1,0,0"
                        BorderBrush="{StaticResource OutlineBrush}" Padding="25,10">
                    <DockPanel>
                        <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                            <TextBlock Text="●" Foreground="{StaticResource SuccessBrush}" FontSize="12"
                                       VerticalAlignment="Center" Margin="0,0,7,0"/>
                            <TextBlock Text="Local Windows Event Logs" Foreground="{StaticResource TextSubtleBrush}"
                                       FontSize="11" VerticalAlignment="Center"/>
                        </StackPanel>
                        <TextBlock x:Name="StatusText" Text="Ready to scan" Style="{StaticResource MutedTextStyle}"
                                   FontSize="11" TextTrimming="CharacterEllipsis"/>
                    </DockPanel>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</ui:FluentWindow>
