<Window x:Class="SystemCrashInspector.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="System Crash Inspector" Height="740" Width="1150"
        MinHeight="500" MinWidth="800" WindowStartupLocation="CenterScreen">
    <DockPanel Margin="16">
        <StackPanel DockPanel.Dock="Top">
            <TextBlock Text="System Crash Inspector" FontSize="24" FontWeight="SemiBold" Margin="0,0,0,10"/>
            <WrapPanel Margin="0,0,0,10" VerticalAlignment="Center">
                <TextBlock Text="Period:" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <ComboBox x:Name="PeriodPicker" Width="150" SelectedIndex="1" Margin="0,0,12,0">
                    <ComboBoxItem Content="Last 7 days" Tag="7"/>
                    <ComboBoxItem Content="Last 30 days" Tag="30"/>
                    <ComboBoxItem Content="Last 90 days" Tag="90"/>
                </ComboBox>
                <Button x:Name="RefreshButton" Content="Refresh" Width="100" Padding="7" Click="Refresh_Click" Margin="0,0,8,0"/>
                <Button x:Name="ExportButton" Content="Export CSV" Width="110" Padding="7" Click="Export_Click"/>
            </WrapPanel>
        </StackPanel>
        <StatusBar DockPanel.Dock="Bottom">
            <TextBlock x:Name="StatusText" Text="Ready"/>
        </StatusBar>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="3*"/>
                <RowDefinition Height="8"/>
                <RowDefinition Height="2*"/>
            </Grid.RowDefinitions>
            <DataGrid x:Name="EventsGrid" Grid.Row="0" AutoGenerateColumns="False"
                      IsReadOnly="True" SelectionMode="Single"
                      SelectionChanged="EventsGrid_SelectionChanged"
                      EnableRowVirtualization="True" CanUserAddRows="False">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Date / time" Binding="{Binding TimeCreated, StringFormat={}{0:yyyy-MM-dd HH:mm:ss}}" Width="170"/>
                    <DataGridTextColumn Header="Log" Binding="{Binding LogName}" Width="100"/>
                    <DataGridTextColumn Header="ID" Binding="{Binding EventId}" Width="65"/>
                    <DataGridTextColumn Header="Category" Binding="{Binding Category}" Width="220"/>
                    <DataGridTextColumn Header="Source" Binding="{Binding Source}" Width="180"/>
                    <DataGridTextColumn Header="Level" Binding="{Binding Level}" Width="110"/>
                    <DataGridTextColumn Header="Message" Binding="{Binding Message}" Width="*"/>
                </DataGrid.Columns>
            </DataGrid>
            <GridSplitter Grid.Row="1" Height="8" HorizontalAlignment="Stretch" ResizeDirection="Rows" Background="#DDDDDD"/>
            <GroupBox Header="Event details" Grid.Row="2" Margin="0,4,0,0">
                <TextBox x:Name="DetailsText" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                         IsReadOnly="True" BorderThickness="0" Padding="10"/>
            </GroupBox>
        </Grid>
    </DockPanel>
</Window>
